# --- OpenAI-compatible gateway (mode: "OpenAI-Compatible API") ---
# Generic wire-style names are supported: API_KEY / BASE_URL / MODEL
# (real values belong in .env — never commit credentials)
API_KEY=
BASE_URL=
MODEL=
OPENAI_TEMPERATURE=0

# --- Open-Source mode ---
# OCR backend used when a page has no text layer:
#   easyocr  (default, supports Persian + English)
#   tesseract (requires the Tesseract binary on PATH)
#   native   (no OCR; pages without a text layer are skipped with a warning)
OCR_MODEL=easyocr
OCR_LANGUAGES=fa,en
# auto | cpu | cuda
DEVICE=auto
# Rendering DPI used before OCR
OCR_DPI=200

# --- General ---
# When true, page images / OCR output / raw model responses / intermediate
# structured data / final XLSX are written to DEBUG_DIR.
DEBUG=false
DEBUG_DIR=debug_output
LOG_LEVEL=INFO

