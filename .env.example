# --- OpenAI-compatible gateway (mode: "OpenAI-Compatible API") ---
# Generic wire-style names are supported: API_KEY / BASE_URL / MODEL
# (real values belong in .env — never commit credentials)
API_KEY=
BASE_URL=
MODEL=
OPENAI_TEMPERATURE=0

# --- Open-Source mode ---
# OCR backend used when a page has no text layer:
#   easyocr  (default, supports Persian + English)
#   trocr    (Persian TrOCR line model; model id via TROCR_MODEL)
#   trocr+gemma (TrOCR proposals corrected by local Gemma 2B; or keep
#     OCR_MODEL=trocr and set OCR_POSTPROCESSOR=gemma)
#   tesseract (requires the Tesseract binary on PATH)
#   native   (no OCR; pages without a text layer are skipped with a warning)
OCR_MODEL=easyocr
TROCR_MODEL=hezarai/trocr-base-fa-v2
# Line post-corrector: none (default) | gemma | trocr+gemma
OCR_POSTPROCESSOR=none
# Gated repo — request access at https://huggingface.co/google/gemma-2-2b-it
# then `huggingface-cli login`
GEMMA_MODEL=google/gemma-2-2b-it
GEMMA_MAX_NEW_TOKENS=256
GEMMA_BATCH_SIZE=8
OCR_LANGUAGES=fa,en
# auto | cpu | cuda
DEVICE=auto
# Rendering DPI used before OCR
OCR_DPI=200

# --- General ---
# When true, page images / OCR output / raw model responses / intermediate
# structured data / final XLSX are written to DEBUG_DIR.
DEBUG=false
DEBUG_DIR=debug_output
LOG_LEVEL=INFO

